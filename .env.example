# Entorno
ENVIRONMENT=development
DEBUG=false

# Base de datos
DATA_DIR=data
DB_FILENAME=finanzas.db

# Como aparece el titular en los estados de cuenta: una transferencia con
# este nombre en el otro extremo es entre cuentas propias, no ingreso
TITULAR=Fernando Barrios

# Excel de origen para la migracion inicial
EXCEL_SOURCE=../Sistema_Financiero_Personal.xlsx

# Reglas financieras por defecto (se copian a la tabla configuracion
# la primera vez; despues se editan desde la app)
MONEDA=MXN
META_AHORRO_INVERSION=0.20
MESES_FONDO_EMERGENCIA=6
MAX_DESEOS=0.30
UMBRAL_GASTO_PEQUENO=200
ALERTA_PRESUPUESTO=0.90
DIA_INICIO_CICLO=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
